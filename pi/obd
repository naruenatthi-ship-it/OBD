#!/bin/bash
# คำสั่งลัดบน Raspberry Pi: พิมพ์ obd เฉยๆ เพื่อเปิดเมนู หรือ obd <คำสั่ง>
# หยุดโหมดอัตโนมัติให้ก่อน แล้วเปิดคืนเองเมื่อเสร็จ (แม้กด Ctrl+C)
# ไฟล์ผลลัพธ์อยู่ใน /var/lib/deepal-obd (ดาวน์โหลดได้จากหน้า /files)
set -uo pipefail

APP=${OBD_APP:-/opt/deepal-obd}
DATA=${OBD_DATA:-/var/lib/deepal-obd}
CONF=${OBD_CONF:-/etc/default/deepal-obd}
SYSTEMCTL=${OBD_SYSTEMCTL:-/usr/bin/systemctl}
STAMP=$(date +%Y%m%d-%H%M)

# shellcheck disable=SC1090
source "$CONF"
OBD_PORT=${OBD_PORT:-}
OBD_OPTIONS=${OBD_OPTIONS:-}
VPS_HOST=${VPS_HOST:-}
# the program reads these from the environment (token stays off the
# command line, where other users could see it)
export TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID

usage() {
    cat <<'EOF'
วิธีใช้: obd            เปิดเมนู
        obd <คำสั่ง>

  check            อ่านค่าทั้งหมด + รหัส BMS (บันทึก check_วันเวลา.json)
  health           ตรวจสุขภาพแบต เก็บประวัติไว้เทียบ
  ir               health + วัด IR แพ็กและรายเซลล์ 60 วินาที (ให้คนอื่นขับ)
  checkup          ตรวจรถรายสัปดาห์ (ค่าแบต + โค้ดปัญหาทุกกล่อง)
  dtc              อ่านโค้ดปัญหาทุกกล่อง (บันทึก dtc_วันเวลา.csv)
  ecus             หากล่อง ECU ทั้งหมด (บันทึก ecus_วันเวลา.csv)
  topo             หากล่อง ECU + อ่านโค้ด แล้วดูแผนผังทั้งคันที่ /topology
  freeze           อ่านภาพนิ่งตอนเกิดโค้ด (freeze frame) ว่ารถทำอะไรอยู่ตอนตั้งโค้ด
  dyno             ไดโนจำลอง + แผนที่ประสิทธิภาพมอเตอร์ จากไฟล์บันทึกขับ
  chargecurve      กราฟการชาร์จเทียบ SOC จากไฟล์ charge_
  clean            ลบไฟล์ที่ไม่จำเป็น (log เก่า หน้ารายงาน ผลเก่า) บอกก่อนแล้วถาม
  predict          เตือนล่วงหน้า: ชิ้นไหนเริ่มผิดปกติ/จะถึงเกณฑ์เมื่อไร (/health)
  scan HEADER [ช่วง]  สแกน DID เช่น obd scan 7A7 0100-01FF (ค่าเริ่มต้น F100-F3FF)
  live             ดูค่าสดในหน้าจอ (Ctrl+C เพื่อหยุด)
  rec [ชื่อ] [นาที] [watch]  บันทึกค่าจากไฟล์ scan ล่าสุดทุก 2 วินาที แบบเบื้องหลัง
                   ใส่ watch = ค่าที่น่าจับตาจากการสำรวจ (700, ความเร็วล้อ 780)
                   ใส่ all = ทุกค่าที่ obd survey เคยเจอ (ใช้หาอุณหภูมิ/ค่าใหม่ตอนขับไกล)
                   เช่น obd rec drive 20 (ปิด Termius/ล็อกจอขับได้เลย)
  stop             หยุดงานเบื้องหลัง (obd rec / obd bg)
  bg <คำสั่ง>       สั่งคำสั่งไหนก็ได้ให้ทำงานเบื้องหลัง เช่น obd bg scan 7A4,742 0100-EFFF
  log              ดูความคืบหน้าของงานเบื้องหลังล่าสุด
  show [คำค้น]      แสดงไฟล์ผลในจอ (ใช้ตอนหน้า /files เปิดไม่ได้) เช่น obd show 7A4
                   ไม่ใส่คำค้น = ไฟล์ scan ล่าสุด
  wifi             ดูว่าต่อ WiFi วงไหนอยู่ + ลำดับที่ Pi เลือกก่อน
  wifi add "ชื่อWiFi" "รหัส" [ลำดับ]  เพิ่ม WiFi (ไม่ใส่ลำดับ = ต่อท้าย)
  wifi first หมายเลข    ย้ายวงนี้ขึ้นอันดับ 1 (Pi ย้ายไปเองเมื่ออยู่ในระยะ)
  wifi order 2 1 3      เรียงลำดับใหม่ทั้งหมด
  wifi use หมายเลข      ย้ายไปวงนี้เดี๋ยวนี้
  wifi remove หมายเลข   ลบ WiFi ที่จำไว้
  vps setup ผู้ใช้@เครื่อง [พอร์ตเว็บ]  ตั้งให้ส่งข้อมูลขึ้น VPS ทุก 15 นาที ดูรถจากที่ไหนก็ได้
  vps sync / vps   ส่งข้อมูลขึ้น VPS เดี๋ยวนี้ / ดูสถานะ (ปกติส่งเองทันทีที่ต่อเน็ตได้)
  vps hotspot on|off  ส่งตอนใช้ Hotspot มือถือด้วยไหม (เริ่มต้น on)
  survey           สถานะการสำรวจ DID ต่อเนื่อง (% ที่เสร็จ, เจอกี่ค่า)
  survey start     เริ่มสำรวจทุกกล่อง (F000-FFFF + สุ่มช่วงเล็ก) ทำต่อเองทุกครั้งที่รถเปิดและจอดนิ่ง
  survey pause / survey resume   หยุด / ทำต่อ (obd stop = หยุดจนสตาร์ทรถรอบหน้า)
  survey digest    สรุปผลใหม่เป็นข้อความสั้น (หรือเปิดหน้า /digest ไม่ต้องพิมพ์)
  soh              วัดความจุแบตจริงจากการชาร์จ (SOH วัดเอง)
  cost             ค่าไฟการชาร์จรายเดือน
  watch all        ให้โหมดอัตโนมัติเก็บทุกค่าที่ survey เจอ ระหว่างขับ (หาอุณหภูมิ/ค่าใหม่, dashboard ยังใช้ได้)
  watch reset      กลับไปเก็บแค่รายการเริ่มต้น · obd watch = ดูว่าเก็บอยู่กี่ค่า
  tyres            เตือนยางอ่อน (เทียบความเร็ว 4 ล้อตอนขับทางตรง, ทดลอง)
  tyres reset      เรียนรู้ยางใหม่ หลังเติมลมให้ถูกต้อง/เปลี่ยนยาง
  canscan [ชื่อ]    ดักฟัง CAN ที่รถกระจายเอง (ฟังอย่างเดียว ~3 นาที) เช่น obd canscan charging
  cancompare       เทียบ canscan สองครั้งล่าสุด
  canfind ตัวเลข    ค้นตัวเลขในผล canscan ล่าสุด เช่น obd canfind 42800 (เลขไมล์หน้าปัด)
  telegram TOKEN   ตั้งแจ้งเตือนผ่าน Telegram (token จาก @BotFather)
  telegram         หาเลข chat / ส่งข้อความทดสอบ
  trip             สรุปทริป: ระยะทาง kWh ที่ใช้ kWh/100 km ความเร็ว/ความร้อนสูงสุด
  eco              แยก kWh/100 km ตามความเร็วนิ่ง + แอร์เปิด/ปิด (จากไฟล์ rec_*.csv)
  pair             จับคู่กล่อง OBD ใหม่
  status           ดูว่าโหมดอัตโนมัติทำงานไหม + log ล่าสุด
  web              บอกที่อยู่หน้า dashboard
  update           อัปเดตโปรแกรมจาก GitHub (ต้องต่อเน็ต)
  off              ปิดเครื่อง Pi (รอไฟเขียวดับก่อนถอดสาย)
  reboot           รีสตาร์ท Pi
  อื่นๆ            ส่งต่อให้โปรแกรมตรงๆ เช่น obd balance, obd record --note test
EOF
}

as_root() {
    if [ "$(id -u)" = 0 ]; then
        "$@"
    else
        sudo -n "$@" 2>/dev/null || sudo "$@"
    fi
}

was_active=0
restore() {
    if [ "$was_active" = 1 ]; then
        as_root "$SYSTEMCTL" start deepal-obd
        echo "(เปิดโหมดอัตโนมัติคืนแล้ว)"
    fi
}

# run the program with the adapter to ourselves, from the data folder so
# history files land where the dashboard and autopilot use them
run() {
    if [ -z "$OBD_PORT" ] || [[ "$OBD_PORT" == *00:00:00:00:00:00* ]]; then
        echo "ยังไม่ได้จับคู่กล่อง OBD: รัน obd pair ก่อน"
        return 1
    fi
    if "$SYSTEMCTL" is-active --quiet deepal-obd; then
        was_active=1
        trap restore EXIT
        as_root "$SYSTEMCTL" stop deepal-obd
    fi
    cd "$DATA" || return 1
    # shellcheck disable=SC2086  # OBD_OPTIONS holds several options
    PYTHONPATH="$APP" python3 -m deepal_s05 --port "$OBD_PORT" \
        $OBD_OPTIONS "$@"
}

# write KEY=VALUE into the settings file (VALUE is checked by the caller)
set_conf() {
    if grep -q "^$1=" "$CONF"; then
        as_root sed -i "s|^$1=.*|$1=$2|" "$CONF"
    else
        echo "$1=$2" | as_root tee -a "$CONF" >/dev/null
    fi
    # the bot token is a password: readable by root and this user only
    as_root chgrp "$(id -gn)" "$CONF" && as_root chmod 640 "$CONF"
}

telegram() {
    local token=${1:-} chats ids
    if [ -n "$token" ]; then
        if ! [[ "$token" =~ ^[0-9]+:[A-Za-z0-9_-]+$ ]]; then
            echo "token ไม่ถูกรูปแบบ (หน้าตาแบบ 123456789:ABCdef...) ก๊อปจาก @BotFather ใหม่"
            return 1
        fi
        set_conf TELEGRAM_BOT_TOKEN "$token"
        export TELEGRAM_BOT_TOKEN=$token
        echo "บันทึก token แล้ว"
    fi
    if [ -z "${TELEGRAM_BOT_TOKEN:-}" ]; then
        echo "ยังไม่มี token: เปิด Telegram คุยกับ @BotFather พิมพ์ /newbot ตั้งชื่อบอท"
        echo "แล้วก๊อป token ที่ได้มาใส่: obd telegram 123456789:ABCdef..."
        return 1
    fi
    cd "$DATA" || return 1
    if [ -z "${TELEGRAM_CHAT_ID:-}" ]; then
        chats=$(PYTHONPATH="$APP" python3 -m deepal_s05 notify-test) || {
            echo "$chats"
            echo "ส่งข้อความอะไรก็ได้หาบอทใน Telegram ก่อน แล้วพิมพ์ obd telegram อีกครั้ง"
            return 1
        }
        ids=$(echo "$chats" | awk '$1 ~ /^-?[0-9]+$/ {print $1}')
        if [ "$(echo "$ids" | wc -l)" != 1 ]; then
            echo "$chats"
            echo "เจอหลาย chat: แก้ TELEGRAM_CHAT_ID ใน $CONF เอง (sudo nano $CONF)"
            return 1
        fi
        set_conf TELEGRAM_CHAT_ID "$ids"
        export TELEGRAM_CHAT_ID=$ids
        echo "บันทึกเลข chat แล้ว"
    fi
    # shellcheck disable=SC2086  # OBD_OPTIONS holds several options
    PYTHONPATH="$APP" python3 -m deepal_s05 $OBD_OPTIONS notify-test &&
        as_root "$SYSTEMCTL" restart deepal-obd &&
        echo "โหมดอัตโนมัติจะแจ้งเตือนเข้า Telegram แล้ว"
}

# build a page from saved files (no adapter needed) and say where it is
page() {
    local kind=$1 out=$2 path=$3 ip
    cd "$DATA" || return 1
    PYTHONPATH="$APP" python3 -m deepal_s05 "$kind" --dir "$DATA" \
        --out "$DATA/$out" >/dev/null || return 1
    ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    echo "เปิดดูใน Safari: http://${ip:-deepal-pi.local}:8000$path"
    echo "(หรือไฟล์ $out ในหน้า /files)"
}

VPS_DIR=deepal-obd

vps_ssh() {
    ssh -o BatchMode=yes -o ConnectTimeout=15 -p "${VPS_SSH_PORT:-22}" \
        "$VPS_HOST" "$@"
}

# what the last copy to the VPS did, for the dashboard status line:
# "ok|fail|syncing|skip date time" (dashboard.VPS_STATE_FILE)
vps_state() {
    echo "$1 $(date '+%F %T')" > "$DATA/.vps_state" 2>/dev/null || true
}

vps_sync() {
    if [ -z "${VPS_HOST:-}" ]; then
        echo "ยังไม่ได้ตั้ง VPS: obd vps setup ผู้ใช้@เครื่อง"
        return 1
    fi
    local rsh="ssh -o BatchMode=yes -o ConnectTimeout=15 -p ${VPS_SSH_PORT:-22}"
    vps_state syncing
    # rsync sends every file that is new or changed since the last copy,
    # so drives recorded without internet go up the next time there is.
    # Scans and job logs can hold ECU identifiers: they stay on the Pi
    if rsync -az -e "$rsh" --exclude 'scan_*' --exclude '*.log' \
            --exclude 'predict_state.json' --exclude '.vps_*' \
            "$DATA/" "$VPS_HOST:$VPS_DIR/data/" &&
        rsync -az --delete -e "$rsh" --exclude '__pycache__' \
            "$APP/" "$VPS_HOST:$VPS_DIR/app/" &&
        vps_ssh "sh $VPS_DIR/app/pi/vps-serve.sh ${VPS_WEB_PORT:-8080}"; then
        date '+%F %T' > "$DATA/.vps_synced"
        vps_state ok
    else
        vps_state fail
        return 1
    fi
}

# run by deepal-vps-sync.service: every 15 minutes and whenever WiFi
# comes up (pi/deepal-vps-dispatch). Quiet when there is nothing to do
vps_auto() {
    [ -n "${VPS_HOST:-}" ] || return 0
    if [ "${VPS_HOTSPOT:-on}" = off ] && [ "$(active_wifi)" = hotspot ]; then
        echo "ไม่ส่งตอนใช้ Hotspot (obd vps hotspot on เพื่อเปิด)"
        vps_state skip
        return 0
    fi
    # the network may need a moment after connecting
    local try
    for try in 1 2 3; do
        vps_sync && return 0
        [ "$try" = 3 ] || sleep 20
    done
    return 1
}

active_wifi() {
    nmcli -t -f NAME,DEVICE connection show --active 2>/dev/null |
        grep ':wlan0$' | cut -d: -f1
}

vps() {
    local action=${1:-status}
    case "$action" in
        setup)
            local host=${2:-} port=${3:-8080} sshport=${4:-22} pw
            if ! [[ "$host" =~ ^[A-Za-z0-9._-]+@[A-Za-z0-9.:_-]+$ ]] ||
                    ! [[ "$port$sshport" =~ ^[0-9]+$ ]]; then
                echo "ใช้แบบนี้: obd vps setup ผู้ใช้@ที่อยู่VPS [พอร์ตเว็บ 8080] [พอร์ต ssh 22]"
                return 1
            fi
            command -v rsync >/dev/null || as_root apt-get install -y rsync
            [ -f "$HOME/.ssh/id_ed25519" ] ||
                ssh-keygen -t ed25519 -N "" -f "$HOME/.ssh/id_ed25519" -q
            echo "==> ใส่รหัสผ่านของ VPS ครั้งเดียว (ต่อไป Pi จะใช้กุญแจแทน)"
            ssh-copy-id -p "$sshport" -i "$HOME/.ssh/id_ed25519.pub" "$host" ||
                return 1
            set_conf VPS_HOST "$host"
            set_conf VPS_WEB_PORT "$port"
            set_conf VPS_SSH_PORT "$sshport"
            VPS_HOST=$host VPS_WEB_PORT=$port VPS_SSH_PORT=$sshport
            vps_ssh "command -v python3 >/dev/null && command -v rsync >/dev/null" || {
                echo "VPS ต้องมี python3 และ rsync (Ubuntu/Debian: sudo apt install python3 rsync)"
                return 1
            }
            pw=$(python3 -c 'import secrets; print(secrets.token_urlsafe(9))')
            echo "$pw" | vps_ssh "mkdir -p $VPS_DIR/data && umask 077 && cat > $VPS_DIR/web_password"
            echo "==> ส่งข้อมูลครั้งแรก (อาจนานหลายนาทีถ้าไฟล์เยอะ)"
            vps_sync || return 1
            # keeps the VPS's other cron jobs; refuses if it cannot read them
            vps_ssh "sh $VPS_DIR/app/pi/vps-cron.sh $port"
            sed "s/@USER@/$(id -un)/" "$APP/pi/deepal-vps-sync.service" |
                as_root tee /etc/systemd/system/deepal-vps-sync.service >/dev/null
            as_root cp "$APP/pi/deepal-vps-sync.timer" /etc/systemd/system/
            as_root "$SYSTEMCTL" daemon-reload
            as_root "$SYSTEMCTL" enable --now deepal-vps-sync.timer
            echo
            echo "เสร็จแล้ว เปิดดูจากที่ไหนก็ได้: http://${host#*@}:$port"
            echo "ชื่อผู้ใช้: อะไรก็ได้   รหัสผ่าน: $pw   (จดไว้ ดูซ้ำได้ด้วย obd vps)"
            echo "Pi จะส่งข้อมูลขึ้นเองทันทีที่ต่อเน็ตได้ และทุก 15 นาที"
            echo "ถ้าเปิดไม่ได้ ให้เปิดพอร์ต $port ใน firewall ของ VPS" ;;
        sync)
            vps_sync && echo "ส่งข้อมูลขึ้น VPS แล้ว" ;;
        auto)
            vps_auto ;;
        hotspot)
            case "${2:-}" in
                on|off) set_conf VPS_HOTSPOT "$2"
                        if [ "$2" = on ]; then
                            echo "ส่งข้อมูลขึ้น VPS ทุกครั้งที่มีเน็ต รวมตอนใช้ Hotspot มือถือ"
                        else
                            echo "ส่งข้อมูลเฉพาะตอนต่อ WiFi อื่น (ไม่ใช้เน็ตมือถือ) · obd vps sync สั่งส่งเองได้เสมอ"
                        fi ;;
                *) echo "ใช้แบบนี้: obd vps hotspot on (ส่งตอนใช้ Hotspot ด้วย) หรือ off (ไม่ส่ง)"
                   return 1 ;;
            esac ;;
        *)
            if [ -z "${VPS_HOST:-}" ]; then
                echo "ยังไม่ได้ตั้ง VPS: obd vps setup ผู้ใช้@เครื่อง"
                return 1
            fi
            echo "VPS: $VPS_HOST  หน้าเว็บ: http://${VPS_HOST#*@}:${VPS_WEB_PORT:-8080}"
            echo "ส่งข้อมูลล่าสุด: $(cat "$DATA/.vps_synced" 2>/dev/null || echo ยังไม่เคย)"
            echo "ครั้งล่าสุดที่ลอง: $(cat "$DATA/.vps_state" 2>/dev/null || echo -)"
            if [ "${VPS_HOTSPOT:-on}" = off ]; then
                echo "ตอนใช้ Hotspot: ไม่ส่ง (obd vps hotspot on เพื่อเปิด)"
            else
                echo "ตอนใช้ Hotspot: ส่งด้วย (obd vps hotspot off เพื่อประหยัดเน็ตมือถือ)"
            fi
            echo "รหัสผ่านหน้าเว็บ: $(vps_ssh "cat $VPS_DIR/web_password" 2>/dev/null || echo 'ต่อ VPS ไม่ได้')" ;;
    esac
}

web() {
    local ip
    ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    echo "หน้า dashboard: http://${ip:-deepal-pi.local}:8000"
    echo "ไฟล์ข้อมูล:     http://${ip:-deepal-pi.local}:8000/files"
}

do_command() {
    local cmd=${1:-}
    shift || true
    case "$cmd" in
        check)   run check --save "$DATA/check_$STAMP.json" "$@" ;;
        health)  run health "$@" ;;
        ir)      run health --ir 60 --cell-ir "$@" ;;
        checkup) run checkup "$@" ;;
        dtc)     run dtc --save "$DATA/dtc_$STAMP.csv" "$@" ;;
        ecus)    run ecus --save "$DATA/ecus_$STAMP.csv" "$@" ;;
        topo|topology)
            run ecus --save "$DATA/ecus_$STAMP.csv" &&
                run dtc --save "$DATA/dtc_$STAMP.csv" &&
                page topology topology.html /topology ;;
        freeze)
            run freeze --save "$DATA/freeze_$STAMP.json" "$@" && {
                local ip
                ip=$(hostname -I 2>/dev/null | awk '{print $1}')
                echo "ดูเป็นตาราง: http://${ip:-deepal-pi.local}:8000/freeze"
            } ;;
        dyno)        page dyno dyno.html /dyno ;;
        clean)
            cd "$DATA" && PYTHONPATH="$APP" python3 -m deepal_s05 clean \
                --dir "$DATA" "$@" ;;
        predict)
            cd "$DATA" && PYTHONPATH="$APP" python3 -m deepal_s05 predict \
                --dir "$DATA" --out "$DATA/health.html" &&
                echo "ดูแบบมีกราฟ: http://$(hostname -I 2>/dev/null | awk '{print $1}'):8000/health" ;;
        chargecurve) page chargecurve charge_curve.html /charge ;;
        scan)
            if [ $# -lt 1 ]; then
                echo "ใส่ header ด้วย เช่น obd scan 7A7 หรือ obd scan 7A7 0100-01FF"
                return 1
            fi
            local header=$1 ranges=${2:-F100-F3FF}
            shift; [ $# -gt 0 ] && shift
            run discover --header "$header" --ranges "$ranges" \
                --save "$DATA/scan_${header//,/_}_$STAMP.csv" "$@" ;;
        live)    run live "$@" ;;
        trip)    cd "$DATA" && PYTHONPATH="$APP" python3 -m deepal_s05 trip "$@" ;;
        eco)     cd "$DATA" && PYTHONPATH="$APP" python3 -m deepal_s05 eco "$@" ;;
        rec)
            local name=${1:-drive} minutes=${2:-20} scan
            case "${3:-}" in
                watch) scan="$APP/examples/watch_live.csv" ;;
                all)   scan="$DATA/survey_results.csv" ;;
                "")    scan=$(ls -t "$DATA"/scan_*.csv 2>/dev/null | head -1) ;;
                *)     scan=$3 ;;
            esac
            if [ -z "$scan" ] || [ ! -f "$scan" ]; then
                echo "ยังไม่มีไฟล์ scan ให้ใช้ สแกนก่อน เช่น obd scan 7A7 F400-FFFF"
                return 1
            fi
            nohup bash "$0" _rec "$name" "$minutes" "$scan" \
                > "$DATA/rec_$name.log" 2>&1 &
            echo "เริ่มบันทึก '$name' $minutes นาที (DID จาก $(basename "$scan"))"
            echo "ทำงานเบื้องหลัง ปิด Termius หรือล็อกจอได้เลย"
            echo "ไฟล์: rec_${name}_$STAMP.csv  หยุดก่อนเวลา: obd stop" ;;
        bg)
            if [ $# -lt 1 ]; then
                echo "ใส่คำสั่งด้วย เช่น obd bg scan 7A4,742 0100-EFFF"
                return 1
            fi
            nohup bash "$0" _bg "$@" > "$DATA/bg_$STAMP.log" 2>&1 &
            echo "เริ่มงานเบื้องหลัง: obd $*"
            echo "ปิด Termius หรือล็อกจอได้เลย ดูความคืบหน้า: obd log  หยุด: obd stop" ;;
        _bg)
            echo $$ > "$DATA/.bg.pid"
            do_command "$@"
            echo "== เสร็จแล้ว ==" ;;
        wifi)
            PYTHONPATH="$APP" python3 -m deepal_s05.wifi "$@" ;;
        log)
            local last
            last=$(ls -t "$DATA"/bg_*.log "$DATA"/rec_*.log 2>/dev/null | head -1)
            if [ -z "$last" ]; then
                echo "ยังไม่มีงานเบื้องหลัง"
            else
                echo "== $(basename "$last") =="
                tail -n 15 "$last"
            fi ;;
        show)
            # the dashboard (and its /files page) is off while a command
            # holds the adapter, so print results to the terminal instead
            local files
            if [ $# -gt 0 ]; then
                files=$(ls -t "$DATA"/*"$1"*.csv "$DATA"/*"$1"*.json 2>/dev/null)
            else
                files=$(ls -t "$DATA"/scan_*.csv 2>/dev/null | head -1)
            fi
            if [ -z "$files" ]; then
                echo "ไม่เจอไฟล์${1:+ ที่มีคำว่า $1}  ดูรายชื่อไฟล์: ls $DATA"
                return 1
            fi
            local f
            for f in $files; do
                echo "== $(basename "$f") ($(($(wc -l < "$f") - 1)) แถว) =="
                cat "$f"
                echo
            done ;;
        _rec)
            echo $$ > "$DATA/.rec.pid"
            run record --dids-from "$3" --note "$1" --skip-known \
                --duration "$(( ${2:-20} * 60 ))" \
                --csv "$DATA/rec_${1}_$STAMP.csv" ;;
        stop)
            # background jobs run as children of an obd _rec/_bg process;
            # they ignore SIGINT, so TERM (the program treats it as Ctrl+C)
            local f pid stopped=0
            for f in "$DATA/.rec.pid" "$DATA/.bg.pid"; do
                pid=$(cat "$f" 2>/dev/null)
                if [ -n "$pid" ] && pkill -TERM -P "$pid" 2>/dev/null; then
                    stopped=1
                fi
                rm -f "$f"
            done
            if [ "$stopped" = 1 ]; then
                echo "หยุดงานเบื้องหลังแล้ว (โหมดอัตโนมัติจะเปิดคืนเอง)"
            else
                echo "ไม่มีงานเบื้องหลังที่กำลังทำงานอยู่"
            fi
            # the survey waits for the next start of the car
            if [ -f "$DATA/survey.json" ]; then
                (cd "$DATA" && PYTHONPATH="$APP" python3 -m deepal_s05 survey \
                    until-wake --dir "$DATA")
            fi ;;
        pair)    bash "$APP/pi/pair.sh" "$@" ;;
        status)
            "$SYSTEMCTL" status deepal-obd --no-pager | head -5
            echo "--- log ล่าสุด ---"
            journalctl -u deepal-obd -n 15 --no-pager
            web ;;
        web)     web ;;
        telegram) telegram "$@" ;;
        vps)     vps "$@" ;;
        survey)
            cd "$DATA" && PYTHONPATH="$APP" python3 -m deepal_s05 survey \
                "${1:-status}" --dir "$DATA" "${@:2}" ;;
        soh|cost)
            cd "$DATA" && PYTHONPATH="$APP" python3 -m deepal_s05 "$cmd" \
                --dir "$DATA" "$@" ;;
        watch)
            local action=${1:-status}
            (cd "$DATA" && PYTHONPATH="$APP" python3 -m deepal_s05 watch \
                "$action" --dir "$DATA") || return 1
            if [ "$action" != status ]; then
                as_root "$SYSTEMCTL" restart deepal-obd &&
                    echo "เริ่มโหมดอัตโนมัติใหม่แล้ว ดู dashboard ได้ตามปกติ"
            fi ;;
        tyres)
            cd "$DATA" && PYTHONPATH="$APP" python3 -m deepal_s05 tyres \
                "${1:-status}" --dir "$DATA" ;;
        canscan)
            run canscan --save "$DATA/canscan_${1:-scan}_$STAMP.csv" ;;
        canfind)
            local last
            last=$(ls -t "$DATA"/canscan_*.csv 2>/dev/null | head -1)
            if [ -z "$last" ] || [ $# -lt 1 ]; then
                echo "ต้อง obd canscan ก่อน แล้ว obd canfind เลขไมล์บนหน้าปัด"
                return 1
            fi
            cd "$DATA" && PYTHONPATH="$APP" python3 -m deepal_s05 canfind \
                "$last" "$@" ;;
        cancompare)
            local a b
            a=$(ls -t "$DATA"/canscan_*.csv 2>/dev/null | sed -n 2p)
            b=$(ls -t "$DATA"/canscan_*.csv 2>/dev/null | sed -n 1p)
            if [ -z "$a" ]; then
                echo "ต้องมี canscan อย่างน้อย 2 ครั้ง เช่น obd canscan charging แล้ว obd canscan parked"
                return 1
            fi
            cd "$DATA" && PYTHONPATH="$APP" python3 -m deepal_s05 cancompare \
                "$a" "$b" ;;
        update)
            local src
            src=$(cat "$APP/.source" 2>/dev/null || echo "$HOME/OBD")
            cd "$src" && git pull && bash pi/install.sh &&
                as_root "$SYSTEMCTL" restart deepal-obd &&
                echo "อัปเดตเสร็จแล้ว" ;;
        off|shutdown)
            echo "กำลังปิดเครื่อง รอไฟเขียวบน Pi ดับ (ประมาณ 20 วินาที) แล้วค่อยถอดสายไฟ"
            as_root /sbin/shutdown -h now ;;
        reboot)
            echo "กำลังรีสตาร์ท รอ 1-2 นาทีแล้วค่อยต่อใหม่"
            as_root /sbin/shutdown -r now ;;
        help|-h|--help) usage ;;
        "")      menu ;;
        [0-9]|[0-9][0-9])
            echo "ตัวเลขใช้ได้เฉพาะในเมนู: พิมพ์ obd เฉยๆ แล้วเลือกหมายเลข"
            echo "หรือพิมพ์ชื่อคำสั่งตรงๆ เช่น obd update, obd check, obd off"
            return 1 ;;
        *)       run "$cmd" "$@" ;;
    esac
}

menu() {
    local items=("check  อ่านค่าทั้งหมด" "health  ตรวจสุขภาพแบต"
                 "ir  วัด IR (ให้คนอื่นขับ)" "checkup  ตรวจรถรายสัปดาห์"
                 "dtc  อ่านโค้ดปัญหา" "ecus  หากล่อง ECU" "live  ดูค่าสด"
                 "topo  แผนผัง ECU ทั้งคัน" "freeze  ภาพนิ่งตอนเกิดโค้ด"
                 "dyno  ไดโน + แผนที่ประสิทธิภาพ" "chargecurve  กราฟการชาร์จ"
                 "predict  เตือนล่วงหน้า" "soh  วัดความจุแบตจริง"
                 "survey  สถานะการสำรวจ DID" "cost  ค่าไฟการชาร์จ" "vps  สถานะ VPS" "clean  ลบไฟล์ที่ไม่จำเป็น"
                 "rec  บันทึกระหว่างขับ 20 นาที (เบื้องหลัง)" "stop  หยุดการบันทึก"
                 "trip  สรุปทริป (km, kWh/100 km)" "log  ดูงานเบื้องหลัง"
                 "wifi  ดู/เรียง WiFi" "off  ปิดเครื่อง Pi" "reboot  รีสตาร์ท Pi"
                 "status  สถานะโหมดอัตโนมัติ" "web  ที่อยู่หน้า dashboard"
                 "update  อัปเดตโปรแกรม" "pair  จับคู่กล่องใหม่" "tyres  เตือนยางอ่อน" "ออก")
    echo "เลือกหมายเลขแล้วกด Enter:"
    PS3="หมายเลข: "
    select item in "${items[@]}"; do
        [ -z "${item:-}" ] && { echo "พิมพ์หมายเลข 1-${#items[@]}"; continue; }
        [ "$item" = "ออก" ] && return 0
        do_command "${item%% *}"
        return $?
    done
}

do_command "$@"
